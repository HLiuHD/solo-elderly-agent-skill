# OpenAI (preferred — set this to use OpenAI API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini (fallback — used when no OpenAI key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backend API (for live mode — fetches real patient data)
BACKEND_API_BASE=https://beibei.bjknrt.com/api
BACKEND_TOKEN=med
